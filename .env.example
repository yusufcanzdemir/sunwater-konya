# Copy to .env.local and fill in. Server-only: never prefix with VITE_.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=
# Chat that receives the web "send alert" demo message (your own Telegram user id)
TELEGRAM_DEMO_CHAT_ID=
# Optional: random string; must match the secret_token given to setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Local dev long-polls Telegram unless set to 0 (polling is skipped automatically when a webhook is set)
TELEGRAM_POLLING=

# Optional: protects the daily cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=

# Optional persistent storage (Upstash Redis / Vercel KV REST); without it, memory is used
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public site URL; the Telegram season summary links to /panel?field=<id> (optional)
PUBLIC_BASE_URL=
